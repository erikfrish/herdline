<?xml version="1.0" encoding="utf-8"?>
<!-- Part of Bellterm, Copyright (c) 2026 Terry Wang, Apache-2.0. Modified for Herdline, 2026: Herdline package, application class, theme and launcher icon. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Lets the monitored-agents card ask to be a Live Update (Android 16). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Hands a verified update to Android's installer; the user confirms there. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets Settings › Live Update ask whether this Android has the promoted-
         notifications page before opening it (API 36.0 has none: QA m43 C5). -->
    <queries>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_PROMOTION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_SETTINGS" />
        </intent>
    </queries>

    <!-- Static package identity: Settings › App info and the notification
         header tile (Samsung's system-drawn left icon) draw this. It is fixed
         at install and can only ship one variant, so it is the Dusk tile the
         user picked; the selectable variants move the launcher aliases below. -->
    <application
        android:name=".HerdlineApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_dusk"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_dusk"
        android:supportsRtl="true"
        android:theme="@style/Theme.Herdline">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Launcher entries, one per icon variant; IconVariants enables exactly one. -->
        <activity-alias
            android:name=".ui.LauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherMono"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mono"
            android:roundIcon="@mipmap/ic_launcher_mono"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherContrast"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_contrast"
            android:roundIcon="@mipmap/ic_launcher_contrast"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherEmber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ember"
            android:roundIcon="@mipmap/ic_launcher_ember"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherSignal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_signal"
            android:roundIcon="@mipmap/ic_launcher_signal"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherPasture"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pasture"
            android:roundIcon="@mipmap/ic_launcher_pasture"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherMeadow"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_meadow"
            android:roundIcon="@mipmap/ic_launcher_meadow"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherDusk"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dusk"
            android:roundIcon="@mipmap/ic_launcher_dusk"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the SSH connection to the user's Herdr terminal daemon open while agents run" />
        </service>

        <!-- Only cacheDir/updates/, read-only to the installer it is granted to. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
